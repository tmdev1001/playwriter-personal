{%- set navItems = [
  { url: "/", label: "Home" },
  { url: "/about/", label: "About" },
  { url: "/plays/", label: "Plays" },
  { url: "/press/", label: "News & Press" },
  { url: "/contact/", label: "Contact" }
] -%}
<header class="site-header">
  <div class="site-header__inner wrap">
    <a class="wordmark" href="/" aria-label="{{ site.title }}, home">
      <span class="wordmark__name">{{ site.title }}</span>
      <span class="wordmark__tag">{{ site.tagline }}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {%- for item in navItems %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
