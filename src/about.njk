---
layout: layouts/base.njk
title: About
permalink: /about/
description: About playwright Malcolm Russell-Einhorn, from a theater family to a career in international development to writing Fragments.
---
<header class="page-head wrap">
  <h1 class="page-title">{{ about.heading }}</h1>
</header>

<div class="wrap about">
  {%- if about.image %}
  <figure class="about__photo">
    <img class="photo" src="{{ about.image }}" alt="{{ about.image_alt }}" sizes="15rem">
  </figure>
  {%- endif %}
  <div class="about__text prose prose--lead">
    {{ about.body | md | safe }}
    <p class="actions">
      <a class="btn" href="/plays/">The Plays</a>
      <a class="btn btn--ghost" href="/contact/">Get in touch</a>
    </p>
  </div>
</div>
